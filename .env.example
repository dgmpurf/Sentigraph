# Backend
APP_ENV=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=sentigraph
REDIS_URL=redis://localhost:6379/0

# Optional API keys
OPENAI_API_KEY=

# Optional Reddit official API credentials.
# Leave blank for MVP mock mode; the Reddit adapter falls back to local mock data.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sentigraph-dev
REDDIT_ADAPTER_MODE=mock

# Optional Bilibili official API credentials.
# Leave blank for MVP mock mode; real official API mode is not implemented yet.
BILIBILI_ADAPTER_MODE=mock
BILIBILI_CLIENT_ID=
BILIBILI_CLIENT_SECRET=
BILIBILI_ACCESS_TOKEN=

# Optional public-page parser scaffold.
# Keep live fetch disabled unless explicitly testing public pages locally.
PUBLIC_PARSER_LIVE_FETCH_ENABLED=false
PUBLIC_PARSER_RATE_LIMIT_SECONDS=3
PUBLIC_PARSER_USER_AGENT=sentigraph-public-parser-dev

# Local case persistence
CASE_STORE_BACKEND=local_json
CASE_STORE_PATH=backend/data/cases.json

# Frontend
VITE_API_BASE_URL=
