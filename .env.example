# Backend
APP_ENV=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=sentigraph
REDIS_URL=redis://localhost:6379/0

# Optional LLM provider scaffold.
# Default is deterministic offline mock mode. Real LLM calls are not implemented yet.
LLM_PROVIDER=mock
LLM_ENABLE_REAL_CALLS=false
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# Optional LLM usage and cost guardrail scaffold.
# Current behavior records safe mock metadata only; no prompts, raw text, or keys are stored.
LLM_USAGE_TRACKING_ENABLED=true
LLM_DAILY_CALL_LIMIT=100
LLM_DAILY_TOKEN_LIMIT=100000
LLM_MAX_INPUT_CHARS=20000
LLM_FAIL_CLOSED_ON_LIMIT=true
LLM_COST_GUARDRAIL_MODE=mock

# Sentiment analyzer mode.
# Default keeps the deterministic rule-based analyzer active.
SENTIMENT_ANALYZER_MODE=rule_based

# Topic cluster summary mode.
# Default keeps deterministic template summaries active.
TOPIC_SUMMARY_MODE=template

# Optional public parser selector repair scaffold.
# Default uses deterministic offline MockProvider suggestions only.
SELECTOR_REPAIR_MODE=mock
SELECTOR_REPAIR_ENABLE_REAL_LLM=false
SELECTOR_REPAIR_MAX_HTML_CHARS=20000

# Optional Reddit official API credentials.
# Leave blank for MVP mock mode; the Reddit adapter falls back to local mock data.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sentigraph-dev
REDDIT_ADAPTER_MODE=mock

# Optional Weibo official API credentials.
# Leave blank for MVP mock mode; real official API mode is not implemented yet.
WEIBO_ADAPTER_MODE=mock
WEIBO_CLIENT_ID=
WEIBO_CLIENT_SECRET=
WEIBO_ACCESS_TOKEN=

# Optional Bilibili official API credentials.
# Leave blank for MVP mock mode; real official API mode is not implemented yet.
BILIBILI_ADAPTER_MODE=mock
BILIBILI_CLIENT_ID=
BILIBILI_CLIENT_SECRET=
BILIBILI_ACCESS_TOKEN=

# Optional Douyin official API credentials.
# Leave blank for MVP mock mode; real official API mode is not implemented yet.
DOUYIN_ADAPTER_MODE=mock
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_ACCESS_TOKEN=

# Optional Kuaishou official API credentials.
# Leave blank for MVP mock mode; real official API mode is not implemented yet.
KUAISHOU_ADAPTER_MODE=mock
KUAISHOU_CLIENT_ID=
KUAISHOU_CLIENT_SECRET=
KUAISHOU_ACCESS_TOKEN=

# Optional Xiaohongshu official API credentials.
# Leave blank for MVP mock mode; real official API mode is not implemented yet.
XIAOHONGSHU_ADAPTER_MODE=mock
XIAOHONGSHU_CLIENT_ID=
XIAOHONGSHU_CLIENT_SECRET=
XIAOHONGSHU_ACCESS_TOKEN=

# Optional Zhihu official API credentials.
# Leave blank for MVP mock mode; real official API mode is not implemented yet.
ZHIHU_ADAPTER_MODE=mock
ZHIHU_CLIENT_ID=
ZHIHU_CLIENT_SECRET=
ZHIHU_ACCESS_TOKEN=

# Optional Douban official API credentials.
# Leave blank for MVP mock mode; real official API mode is not implemented yet.
DOUBAN_ADAPTER_MODE=mock
DOUBAN_CLIENT_ID=
DOUBAN_CLIENT_SECRET=
DOUBAN_ACCESS_TOKEN=

# Optional Toutiao official API credentials.
# Leave blank for MVP mock mode; real official API mode is not implemented yet.
TOUTIAO_ADAPTER_MODE=mock
TOUTIAO_CLIENT_ID=
TOUTIAO_CLIENT_SECRET=
TOUTIAO_ACCESS_TOKEN=

# Optional public-page parser scaffold.
# Keep live fetch disabled unless explicitly testing public pages locally.
PUBLIC_PARSER_LIVE_FETCH_ENABLED=false
PUBLIC_PARSER_RATE_LIMIT_SECONDS=3
PUBLIC_PARSER_USER_AGENT=sentigraph-public-parser-dev

# Local case persistence
CASE_STORE_BACKEND=local_json
CASE_STORE_PATH=backend/data/cases.json

# Frontend
VITE_API_BASE_URL=
