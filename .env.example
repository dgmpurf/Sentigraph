# Backend
APP_ENV=development
MONGODB_URI=mongodb://localhost:27017/sentigraph
REDIS_URL=redis://localhost:6379/0

# Optional API keys
OPENAI_API_KEY=

# Optional Reddit official API credentials.
# Leave blank for MVP mock mode; the Reddit adapter falls back to local mock data.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sentigraph-dev
REDDIT_ADAPTER_MODE=mock

# Local case persistence
CASE_STORE_BACKEND=local_json
CASE_STORE_PATH=backend/data/cases.json

# Frontend
VITE_API_BASE_URL=
