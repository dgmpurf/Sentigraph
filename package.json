{
  "name": "sentigraph",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "backend:install": "python -m pip install -r backend/requirements.txt",
    "backend:dev": "python -m uvicorn app.main:app --reload --app-dir backend --host 127.0.0.1 --port 8000",
    "backend:test": "python -m pytest",
    "data:reset": "python scripts/reset_local_data.py --yes",
    "data:seed": "python scripts/seed_demo_cases.py --reset-first",
    "api:smoke": "python scripts/api_smoke_check.py",
    "frontend:install": "cd frontend && npm install",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build"
  }
}
